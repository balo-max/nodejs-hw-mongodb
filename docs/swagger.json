  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "name",
          "phoneNumber",
          "contactType"
        ],
        "properties": {
          "_id": {
            "description": "Contact id",
            "type": "string",
            "example": "6839dc66812ffad184130baf"
          },
          "userId": {
            "description": "ID of the user who created the contact",
            "type": "string",
            "example": "68406f45b281423eadb03aa2"
          },
          "name": {
            "description": "Contact's name",
            "type": "string",
            "example": "Max Doe"
          },
          "phoneNumber": {
            "description": "Contact's phonenumber",
            "type": "string",
            "example": "+380501114455"
          },
          "email": {
            "description": "Contact's email",
            "type": "string",
            "example": "MaxDoe@gmail.com"
          },
          "isFavourite": {
            "description": "Whether is contact a favourite",
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "description": "Contact's type",
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ]
          },
          "photo": {
            "description": "Link to contact's photo",
            "type": "string",
            "example": "https://res.cloudinary.com/dh0wcgrhc/image/upload/v1749148752/ktuoij9iktjyk7ibdnbm.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "user": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "description": "User name",
            "type": "string",
            "example": "Max Doe"
          },
          "email": {
            "description": "User email",
            "type": "string",
            "example": "MaxDoe@gmail.com"
          },
          "_id": {
            "description": "User id",
            "type": "string",
            "example": "6839dc66812ffad184130baf"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "loginUser": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "accessToken": {
            "description": "Access Token",
            "type": "string",
            "example": "xep6jBmup7XcIzfqtr0X5ZIPTQnGTsetBTdqNX/E"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "UnauthorizedError"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Access token expired"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Found error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
